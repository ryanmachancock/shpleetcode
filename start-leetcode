#!/usr/bin/env bash

# ShpleetCode - NeetCode Practice Environment Launcher
# Opens tmux with Neovim + Claude Code for interview prep

set -e

# Paths
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
LEETCODE_DIR="$HOME/.leetcode"
PROBLEMS_FILE="$LEETCODE_DIR/problems.json"
WORKSPACE_DIR="$LEETCODE_DIR/workspace"
MCP_SERVER_DIR="$SCRIPT_DIR/leetcode-mcp-server"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check dependencies
check_dependencies() {
  local missing=()

  command -v fzf >/dev/null 2>&1 || missing+=("fzf")
  command -v tmux >/dev/null 2>&1 || missing+=("tmux")
  command -v nvim >/dev/null 2>&1 || missing+=("nvim")
  command -v claude >/dev/null 2>&1 || missing+=("claude")
  command -v node >/dev/null 2>&1 || missing+=("node")

  if [ ${#missing[@]} -gt 0 ]; then
    echo -e "${RED}Error: Missing dependencies: ${missing[*]}${NC}"
    exit 1
  fi
}

# Check if problems database exists
check_database() {
  if [ ! -f "$PROBLEMS_FILE" ]; then
    echo -e "${RED}Error: Problems database not found!${NC}"
    echo "Run: cd $MCP_SERVER_DIR && npm run scrape"
    exit 1
  fi
}

# Select problem using fzf
select_problem() {
  local filter="${1:-}"

  # Generate problem list first (avoid buffering issues)
  local problem_list
  problem_list=$(PROBLEMS_FILE="$PROBLEMS_FILE" LEETCODE_DIR="$LEETCODE_DIR" DIFFICULTY_FILTER="$filter" node -e '
    const fs = require("fs");
    const db = JSON.parse(fs.readFileSync(process.env.PROBLEMS_FILE, "utf8"));
    const progress = fs.existsSync(process.env.LEETCODE_DIR + "/progress.json")
      ? JSON.parse(fs.readFileSync(process.env.LEETCODE_DIR + "/progress.json", "utf8"))
      : { solved: {} };

    const filterVal = process.env.DIFFICULTY_FILTER || "";
    const diffColors = { Easy: "\x1b[32m", Medium: "\x1b[33m", Hard: "\x1b[31m" };
    db.problems
      .filter(p => !filterVal || p.difficulty === filterVal)
      .forEach(p => {
        const solved = progress.solved[p.id] ? "\x1b[32m✓\x1b[0m" : "\x1b[2m○\x1b[0m";
        const blind = p.blind75 ? "[B75]" : "     ";
        const diff = (diffColors[p.difficulty] + p.difficulty + "\x1b[0m").padEnd(15);
        const cat = p.category.padEnd(20);
        const id = p.id.padEnd(51);
        console.log(`${id} │ ${solved} ${diff} ${cat} ${blind} ${p.title}`);
      });
  ')

  # Pipe to fzf
  local selection
  selection=$(echo "$problem_list" | fzf \
    --ansi \
    --header="Search by title, ID, category, or difficulty. Esc=cancel" \
    --header-first \
    --bind='ctrl-j:down,ctrl-k:up' \
    --preview="PROBLEMS_FILE=$PROBLEMS_FILE PROBLEM_ID=\$(echo {} | awk '{print \$1}') node '$SCRIPT_DIR/preview-problem.js'" \
    --preview-window=right:50%:wrap \
    --prompt="Problem > ")

  if [ -z "$selection" ]; then
    # Return empty string - will be handled by caller
    return
  fi

  # Extract problem ID (first field, whitespace-delimited, trim spaces)
  echo "$selection" | awk '{print $1}' | xargs
}

# Create problem file if it doesn't exist
create_problem_file() {
  local problem_id="$1"

  # Safety check
  if [ -z "$problem_id" ]; then
    echo "Error: No problem ID provided" >&2
    exit 1
  fi

  # Get problem details
  local problem_info
  problem_info=$(node -e "
    const fs = require('fs');
    const path = require('path');
    const db = JSON.parse(fs.readFileSync('$PROBLEMS_FILE', 'utf8'));
    const p = db.problems.find(x => x.id === '$problem_id');

    if (!p) {
      console.error('Problem not found');
      process.exit(1);
    }

    const categoryDir = p.category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const filename = String(p.number).padStart(3, '0') + '-' + p.titleSlug + '.java';
    const filepath = path.join('$WORKSPACE_DIR', categoryDir, filename);

    // Clean description: remove HTML tags, decode entities, normalize whitespace
    const cleanDesc = p.description
      .replace(/<sup>(.*?)<\/sup>/g, '^\$1')
      .replace(/<sub>(.*?)<\/sub>/g, '_(\$1)')
      .replace(/<code>(.*?)<\/code>/g, '\`\$1\`')
      .replace(/<[^>]*>/g, '')
      .replace(/&nbsp;/g, ' ')
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&quot;/g, '\"')
      .replace(/&#39;/g, \"'\")
      .replace(/\\n/g, ' ')
      .replace(/\\r/g, '')
      .replace(/\\t/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

    console.log(JSON.stringify({
      filepath,
      categoryDir,
      filename,
      title: p.title,
      difficulty: p.difficulty,
      category: p.category,
      description: cleanDesc,
      boilerplate: p.boilerplate.java,
      leetcodeUrl: p.leetcodeUrl,
      neetcodeUrl: p.neetcodeUrl
    }));
  ")

  local parsed
  parsed=$(echo "$problem_info" | node -e "
    let d = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', c => d += c);
    process.stdin.on('end', () => { const o = JSON.parse(d); console.log(o.filepath); console.log(o.categoryDir); });
  ")
  local filepath
  filepath=$(echo "$parsed" | sed -n '1p')
  local category_dir
  category_dir=$(echo "$parsed" | sed -n '2p')

  # Create directory if needed
  mkdir -p "$WORKSPACE_DIR/$category_dir"

  # Define problem filepath
  local problem_filepath="${filepath%.java}-problem.md"

  # Create files if they don't exist
  if [ ! -f "$filepath" ] || [ ! -f "$problem_filepath" ]; then
    # Write both solution file and problem description
    echo "$problem_info" | node -e "
      const fs = require('fs');
      const path = require('path');

      let data = '';
      process.stdin.setEncoding('utf8');
      process.stdin.on('data', chunk => data += chunk);
      process.stdin.on('end', () => {
        const info = JSON.parse(data);

        // Create solution file if it doesn't exist (minimal header)
        if (!fs.existsSync(info.filepath)) {
          const solutionContent = \`/*
 * \${info.title}
 * Difficulty: \${info.difficulty} | Category: \${info.category}
 * LeetCode: \${info.leetcodeUrl}
 * NeetCode: \${info.neetcodeUrl}
 */

\${info.boilerplate}
\`;

          fs.writeFileSync(info.filepath, solutionContent);
        }

        // Create problem description file (markdown)
        const problemPath = info.filepath.replace('.java', '-problem.md');

        // Format description with proper line breaks
        const formattedDesc = info.description
          // Add breaks before Examples
          .replace(/(Example \d+:)/g, '\\n\\n**$1**\\n\\n')
          // Format Input/Output/Explanation
          .replace(/Input:/g, '**Input:** ')
          .replace(/Output:/g, '\\n**Output:** ')
          .replace(/Explanation:/g, '\\n**Explanation:** ')
          // Section headers
          .replace(/Constraints:/g, '\\n\\n## Constraints\\n\\n')
          .replace(/Follow[- ]up:/gi, '\\n\\n## Follow-up\\n\\n')
          .replace(/Note:/g, '\\n\\n**Note:** ')
          // Break long sentences at period followed by space and capital letter
          .replace(/\. ([A-Z])/g, '.\\n\\n$1')
          // Clean up multiple newlines
          .replace(/\\n{3,}/g, '\\n\\n');

        const problemContent = \`# \${info.title}

**Difficulty:** \${info.difficulty}
**Category:** \${info.category}
**LeetCode:** \${info.leetcodeUrl}
**NeetCode:** \${info.neetcodeUrl}

---

## Problem Description

\${formattedDesc}
\`;

        fs.writeFileSync(problemPath, problemContent);
        console.error('Files created');
      });
    " >/dev/null

    # Small delay to ensure filesystem sync
    sleep 0.2

    # Verify file exists and has content
    if [ -f "$filepath" ] && [ -s "$filepath" ]; then
      echo -e "${GREEN}Created: $filepath${NC}" >&2
    else
      echo -e "${RED}Error: Failed to create file properly${NC}" >&2
      exit 1
    fi
  else
    echo -e "${BLUE}Opening existing files: $filepath${NC}" >&2
  fi

  # Output both filepath and problem filepath
  echo "$filepath"
  echo "$problem_filepath"
}

# Regenerate -problem.md files from the problems database
regenerate_problem_files() {
  local target_id="${1:-}"

  if [ -n "$target_id" ]; then
    echo -e "${YELLOW}Regenerating: $target_id${NC}"
  else
    echo -e "${YELLOW}Regenerating all problem description files...${NC}"
  fi

  local count
  count=$(PROBLEMS_FILE="$PROBLEMS_FILE" WORKSPACE_DIR="$WORKSPACE_DIR" TARGET_ID="$target_id" node <<'NODESCRIPT'
const fs = require('fs');
const path = require('path');
const db = JSON.parse(fs.readFileSync(process.env.PROBLEMS_FILE, 'utf8'));
const workspaceDir = process.env.WORKSPACE_DIR;
const targetId = process.env.TARGET_ID || '';

const problems = targetId
  ? db.problems.filter(p => p.id === targetId)
  : db.problems;

if (targetId && problems.length === 0) {
  process.stderr.write('Problem not found: ' + targetId + '\n');
  process.exit(1);
}

let count = 0;
for (const p of problems) {
  const categoryDir = p.category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
  const filename = String(p.number).padStart(3, '0') + '-' + p.titleSlug + '.java';
  const javaPath = path.join(workspaceDir, categoryDir, filename);
  const mdPath = javaPath.replace('.java', '-problem.md');

  if (!fs.existsSync(javaPath)) continue;

  const cleanDesc = p.description
    .replace(/<sup>(.*?)<\/sup>/g, '^$1')
    .replace(/<sub>(.*?)<\/sub>/g, '_($1)')
    .replace(/<code>(.*?)<\/code>/g, '`$1`')
    .replace(/<[^>]*>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\n/g, ' ')
    .replace(/\r/g, '')
    .replace(/\t/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const formattedDesc = cleanDesc
    .replace(/(Example \d+:)/g, '\n\n**$1**\n\n')
    .replace(/Input:/g, '**Input:** ')
    .replace(/Output:/g, '\n**Output:** ')
    .replace(/Explanation:/g, '\n**Explanation:** ')
    .replace(/Constraints:/g, '\n\n## Constraints\n\n')
    .replace(/Follow[- ]up:/gi, '\n\n## Follow-up\n\n')
    .replace(/Note:/g, '\n\n**Note:** ')
    .replace(/\. ([A-Z])/g, '.\n\n$1')
    .replace(/\n{3,}/g, '\n\n');

  const content = `# ${p.title}

**Difficulty:** ${p.difficulty}
**Category:** ${p.category}
**LeetCode:** ${p.leetcodeUrl}
**NeetCode:** ${p.neetcodeUrl}

---

## Problem Description

${formattedDesc}
`;

  fs.writeFileSync(mdPath, content);
  count++;
}

process.stdout.write(String(count));
NODESCRIPT
  )

  echo -e "${GREEN}Regenerated $count problem description file(s).${NC}"
}

# Mark a problem solved via CLI (without needing Claude as intermediary)
mark_solved_cli() {
  local problem_id="$1"
  local progress_file="$LEETCODE_DIR/progress.json"

  if [ ! -f "$progress_file" ]; then
    echo -e "${RED}Error: Progress file not found: $progress_file${NC}"
    exit 1
  fi

  PROBLEM_ID="$problem_id" PROGRESS_FILE="$progress_file" node <<'NODESCRIPT'
const fs = require('fs');
const progressFile = process.env.PROGRESS_FILE;
const problemId = process.env.PROBLEM_ID;
const progress = JSON.parse(fs.readFileSync(progressFile, 'utf8'));
if (!progress.solved) progress.solved = {};
progress.solved[problemId] = { solvedAt: new Date().toISOString(), notes: '' };
fs.writeFileSync(progressFile, JSON.stringify(progress, null, 2));
process.stdout.write('Marked ' + problemId + ' as solved.\n');
NODESCRIPT
}

# Launch tmux session
launch_tmux() {
  local filepath="$1"
  local problem_filepath="$2"
  local session_name="leetcode"

  # Verify files exist and have content before launching
  if [ ! -f "$filepath" ] || [ ! -s "$filepath" ]; then
    echo -e "${RED}Error: Solution file does not exist or is empty: $filepath${NC}"
    echo "Waiting for file to be ready..."
    sleep 0.5
    if [ ! -f "$filepath" ] || [ ! -s "$filepath" ]; then
      echo -e "${RED}Fatal: File still not ready. Aborting.${NC}"
      exit 1
    fi
  fi

  echo -e "${GREEN}Files verified: $filepath ($(stat -c '%s' "$filepath") bytes)${NC}"

  # Kill existing session if it exists
  tmux kill-session -t "$session_name" 2>/dev/null || true

  # Create new session with explicit size
  tmux new-session -d -s "$session_name" -x 200 -y 50

  # Split window horizontally (left/right 50/50)
  tmux split-window -h -t "$session_name"

  # Split right pane vertically (top/bottom) for Claude and problem description
  tmux split-window -v -t "$session_name:0.1" -l 30

  # Small delay to ensure tmux panes are ready
  sleep 0.1

  # Write current file path for MCP server
  echo "$filepath" > "$LEETCODE_DIR/.current-file"

  # Clean stale swap files for this file
  local swap_name
  swap_name=$(echo "$filepath" | sed 's|/|%|g')
  rm -f "$HOME/.local/state/nvim/swap/${swap_name}.swp" 2>/dev/null || true
  rm -f "$HOME/.local/share/nvim/swap/${swap_name}.swp" 2>/dev/null || true

  # Pane 0 (left): Open solution in Neovim
  tmux send-keys -t "$session_name:0.0" "nvim -c 'set updatetime=1000 | autocmd CursorHold,CursorHoldI <buffer> silent! write' '$filepath'" C-m

  # Pane 1 (top right): Start Claude Code with MCP server
  tmux send-keys -t "$session_name:0.1" "claude" C-m

  # Pane 2 (bottom right): Display problem description in nvim
  tmux send-keys -t "$session_name:0.2" "nvim -R -c 'setlocal nomodifiable nonumber norelativenumber signcolumn=no' '$problem_filepath'" C-m

  # Select Neovim pane
  tmux select-pane -t "$session_name:0.0"

  # Attach to session
  tmux attach-session -t "$session_name"
}

# Main
main() {
  echo -e "${BLUE}"
  echo "╔═══════════════════════════════════════╗"
  echo "║                                       ║"
  echo "║            ShpleetCode  🚀            ║"
  echo "║     NeetCode Practice Environment     ║"
  echo "║                                       ║"
  echo "╚═══════════════════════════════════════╝"
  echo -e "${NC}"

  check_dependencies
  check_database

  # Parse arguments
  local filter=""
  case "${1:-}" in
    --regen)
      regenerate_problem_files "${2:-}"
      exit 0
      ;;
    --mark)
      if [ -z "${2:-}" ]; then
        echo -e "${RED}Error: --mark requires a problem ID (e.g. --mark 0001-two-sum)${NC}"
        exit 1
      fi
      mark_solved_cli "$2"
      exit 0
      ;;
    "")
      ;;
    *)
      filter=$(echo "$1" | awk '{print toupper(substr($0,1,1)) tolower(substr($0,2))}')
      if [[ "$filter" != "Easy" && "$filter" != "Medium" && "$filter" != "Hard" ]]; then
        echo -e "${RED}Error: Invalid difficulty '$1'. Use Easy, Medium, or Hard.${NC}"
        exit 1
      fi
      ;;
  esac

  # Select problem
  echo -e "${YELLOW}Launching problem selector...${NC}"
  local problem_id
  problem_id=$(select_problem "$filter")

  # Check if a problem was actually selected
  if [ -z "$problem_id" ]; then
    echo -e "${YELLOW}No problem selected. Exiting.${NC}"
    exit 0
  fi

  echo -e "\n${GREEN}Selected: $problem_id${NC}\n"

  # Create/find files (returns both solution and problem filepath)
  local files
  files=$(create_problem_file "$problem_id")
  local filepath=$(echo "$files" | sed -n '1p')
  local problem_filepath=$(echo "$files" | sed -n '2p')

  # Launch tmux
  echo -e "${BLUE}Launching tmux session...${NC}"
  launch_tmux "$filepath" "$problem_filepath"
}

main "$@"
